---
import Base from '../layouts/Base.astro';
import { Content as Archiv } from '../generated/rodina_a_archiv.md';
import archivText from '../generated/rodina_a_archiv.md?raw';
import { Content as Zajimavosti } from '../generated/zajimavosti.md';
import { lines, linesTitle } from '../lib/data.js';
const maArchiv = archivText.trim().length > 0;
---
<Base title={maArchiv ? 'Zajímavosti a archiv' : 'Zajímavosti'}>
  {maArchiv ? (
    <>
      <h1>Zajímavosti a archiv</h1>
      <p class="lead">Co říkají rodinné doklady a co matriky, kde se liší a co rodina nevěděla. Pod tím, co nás při hledání nejvíc překvapilo – nejstarší předek, spojené větve, řemesla a osudy.</p>
      <p class="small"><a href="#archiv">Rodina a archiv</a> · <a href="#zajimavosti">Zajímavosti z rodokmenu</a></p>
      <h2 id="archiv" class="part">Rodina a archiv</h2>
      <div class="prose"><Archiv /></div>
      <p class="small muted">Každý údaj má u osoby odkaz na snímek zápisu z matriky – <a href="/zapisy/">Zápisy →</a></p>
      <h2 id="zajimavosti" class="part">Zajímavosti z rodokmenu</h2>
    </>
  ) : (
    <>
      <h1>Zajímavosti z rodokmenu</h1>
      <p class="lead">Co nás při hledání nejvíc překvapilo – nejstarší předek, spojené větve, řemesla a osudy.</p>
    </>
  )}
  <div class="prose"><Zajimavosti /></div>

  <div class="next-step">
    <p><strong>Ponořte se hlouběji:</strong> projděte si jednotlivé rody, podívejte se na mapě, kde předci žili, nebo najděte kohokoli ve vějíři všech předků.</p>
    <p><a class="btn" href="/rody/">{linesTitle(Object.keys(lines).length)} →</a> <a class="btn" href="/mapa/">Mapa →</a> <a class="btn" href="/vejir/">Vějíř předků →</a></p>
  </div>
</Base>

<style>
  .part { margin-top: 2.5rem; padding-bottom: .3rem; border-bottom: 2px solid currentColor; }
</style>
